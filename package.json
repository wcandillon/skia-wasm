{
  "name": "skia-wasm",
  "version": "0.0.0",
  "description": "Skia Graphite on WebGPU, compiled to WebAssembly",
  "license": "MIT",
  "author": "William Candillon",
  "keywords": [
    "skia",
    "webgpu",
    "wasm",
    "webassembly",
    "graphite",
    "canvas",
    "2d",
    "graphics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wcandillon/skia-wasm.git"
  },
  "homepage": "https://github.com/wcandillon/skia-wasm",
  "bugs": {
    "url": "https://github.com/wcandillon/skia-wasm/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/wcandillon"
  },
  "sideEffects": false,
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./skia-wasm.js": "./dist/lib/skia-wasm.js",
    "./skia-wasm.wasm": "./dist/lib/skia-wasm.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib/**/*"
  ],
  "packageManager": "yarn@3.6.4",
  "scripts": {
    "prepare-skia": "tsx scripts/skia.ts",
    "generate-exports": "tsx scripts/generate-exports.ts",
    "build": "tsx scripts/build.ts",
    "build-bench": "tsx scripts/build-bench.ts",
    "serve": "tsx scripts/serve.ts",
    "test": "yarn build && yarn test:node && yarn test:web",
    "test:node": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:web": "playwright test",
    "bench": "yarn build-bench && tsx scripts/run-bench.ts",
    "bench-report": "tsx scripts/bench-report.ts",
    "release": "semantic-release",
    "lint": "eslint . --ext .ts --max-warnings 0 --cache --fix",
    "lint:ci": "eslint . --ext .ts --max-warnings 0 --cache",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.69"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/pngjs": "^6.0.5",
    "canvaskit-wasm": "0.41.1",
    "esbuild": "~0.28.0",
    "eslint": "9.36.0",
    "eslint-config-react-native-wcandillon": "5.0.1",
    "extract-zip": "^2.0.1",
    "jest": "30.5.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "semantic-release": "^25.0.9",
    "semantic-release-yarn": "^3.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "webgpu": "0.6.2"
  }
}
